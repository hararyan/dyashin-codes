FUNCTIONS IN javascript

//named function
function add(a,b){
    return a+b;
}

console.log(add(10,20));

//anonymous function

let sub = function (a,b){
    return a-b;
}
console.log(sub(20,10));


//iife - Immediate invoked function expression

let mul = (function(a,b){
    return a*b;
}(10,20))

console.log(mul);


//Arrow function -->ES6 FEATURE

let div = (a,b)=>{
    return a/b;
}

console.log(div(10,2));


